rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        "REEMPLAZA_CON_EL_CORREO_DE_LA_ADMIN@gmail.com"
      ] && request.auth.token.email_verified == true;
    }

    function isBlocked() {
      let path = /databases/$(database)/documents/config/bloqueos;
      return exists(path) && get(path).data.ids.keys().hasAny([request.auth.uid]);
    }

    match /tareas/{tareaId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cuentas/{cuentaId} {
      allow read, write: if isAdmin();
      allow read: if signedIn() && request.auth.uid == cuentaId;
      allow create, update: if signedIn() && request.auth.uid == cuentaId && !isBlocked();
    }

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
